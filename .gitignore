# Secrets — never commit
.env
**/.env
!**/.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/

# Large raw Olist CSVs (download per datasets/README.md)
datasets/*.csv
datasets/incremental/*.csv
!datasets/incremental/.gitkeep

# Generated artifacts (regenerate via scripts)
data/*
!data/.gitkeep

# Power BI binaries (rebuild locally; PBIP scaffold is in repo)
*.pbix
*.pbit
powerbi/**/.pbi/

# Report PDF export (source: PROJECT_RESEARCH_REPORT.md)
PROJECT_RESEARCH_REPORT.pdf
PROJECT*_RESEARCH_REPORT.pdf

# IDE / OS
.cursor/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
