table sales_fact

partition 'sales_fact' = m
        mode: import
        source =
            let
                Source = Csv.Document(
                    File.Contents("..\..\data\powerbi\\sales_fact.csv"),
                    [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                ),
                #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true])
            in
                #"Promoted Headers"
