table forecast_vs_actual

partition 'forecast_vs_actual' = m
        mode: import
        source =
            let
                Source = Csv.Document(
                    File.Contents("..\..\data\powerbi\\forecast_vs_actual.csv"),
                    [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                ),
                #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true])
            in
                #"Promoted Headers"
