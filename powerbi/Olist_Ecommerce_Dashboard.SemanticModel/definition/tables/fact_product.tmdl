table fact_product

partition 'fact_product' = m
        mode: import
        source =
            let
                Source = Csv.Document(
                    File.Contents("..\..\data\powerbi\\fact_product.csv"),
                    [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                ),
                #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true])
            in
                #"Promoted Headers"
