table dim_date

partition 'dim_date' = m
        mode: import
        source =
            let
                Source = Csv.Document(
                    File.Contents("..\..\data\powerbi\\dim_date.csv"),
                    [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                ),
                #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true])
            in
                #"Promoted Headers"
