table fact_monthly

partition 'fact_monthly' = m
        mode: import
        source =
            let
                Source = Csv.Document(
                    File.Contents("..\..\data\powerbi\\fact_monthly.csv"),
                    [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                ),
                #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true])
            in
                #"Promoted Headers"
