# MySQL connection (application user — created by setup)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=olist_analytics
DB_USER=olist_user
DB_PASSWORD=olist_pass

# Root password — required only for initial database setup (scripts/setup_mysql.py)
# Use quotes if your password contains special characters: MYSQL_ROOT_PASSWORD="your@password"
MYSQL_ROOT_PASSWORD=
